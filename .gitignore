# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# THA4 model weights — large (610MB) and CC BY-NC 4.0; do NOT commit.
# Download separately (see README / tools/fetch_weights.sh).
/data/tha4/*.zip
/data/tha4/*.pt
/data/tha4/*.safetensors
/data/tha4/tha4-models/

# Python (weight-conversion tooling / reference oracle)
.venv/
__pycache__/
*.pyc

# Generated demo output
/out/
*.mp4

# Web app (browser renderer)
node_modules/
/web/dist/
# Vite's dependency cache. Regenerated on every dev/test run, so leaving it
# untracked just makes `git status` dirty after running the suite.
/web/.vite/
# Student ONNX exports — regenerate with tools/export_student.py
/data/character_models/*/onnx/
/data/character_models/*/reference/

# macOS
.DS_Store
/data/tha4/onnx/
/data/tha4/reference/

# THA4 sample character images (CC BY-NC) — fetch separately
/data/images/lambda_*.png
/data/character_models/
/data/thirdparty/
/third_party/tha4_src/

.venv-coreml/
*.mlpackage

# Distillation env / training data & intermediates (large; re-fetch via DISTILL.md)
.venv-distill/
/data/pose_dataset.pt
/data/distill_examples/*/checkpoint/
/data/distill_examples/*/snapshot/
/data/distill_examples/*/sample_outputs/
/data/distill_examples/*/face_morpher/
/data/distill_examples/*/body_morpher/
/data/distill_examples/*/character_model/
